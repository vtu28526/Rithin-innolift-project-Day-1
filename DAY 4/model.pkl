import joblib
import matplotlib.pyplot as plt
import pandas as pd
from imblearn.over_sampling import SMOTE
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LinearRegression
from sklearn.metrics import classification_report, mean_absolute_error, r2_score
from sklearn.model_selection import train_test_split


df = pd.read_csv("disease_outbreak_sample.csv")

df["vaccination_rate"] = df["vaccination_rate"].fillna(df["vaccination_rate"].median())
df["population_density"] = df["population_density"].fillna(df["population_density"].median())
df["sanitation_score"] = df["sanitation_score"].fillna(df["sanitation_score"].median())
df["cases_last_week"] = df["cases_last_week"].fillna(df["cases_last_week"].median())

df["risk_index"] = (
    0.40 * ((100 - df["vaccination_rate"]) / 100)
    + 0.35 * (df["population_density"] / df["population_density"].max())
    + 0.25 * ((100 - df["sanitation_score"]) / 100)
)

risk_order = ["Low", "Medium", "High", "Critical"]
features = ["vaccination_rate", "population_density", "sanitation_score", "risk_index"]

print("Dataset Loaded")
print(df.head())
print("\nRisk Classes")
print(df["risk_class"].value_counts())


plt.figure(figsize=(8, 5))
df["risk_class"].value_counts().reindex(risk_order).plot(
    kind="bar",
    color=["#22c55e", "#f59e0b", "#ef4444", "#7c3aed"],
    edgecolor="black",
)
plt.title("Disease Outbreak Risk Classes", fontsize=16, fontweight="bold")
plt.xlabel("Risk Class")
plt.ylabel("Number of Records")
plt.grid(axis="y", linestyle="--", alpha=0.4)
plt.tight_layout()
plt.show()


plt.figure(figsize=(8, 5))
plt.scatter(
    df["population_density"],
    df["vaccination_rate"],
    c=df["risk_class"].map(
        {
            "Low": "#22c55e",
            "Medium": "#f59e0b",
            "High": "#ef4444",
            "Critical": "#7c3aed",
        }
    ),
    edgecolor="black",
    s=90,
)
plt.title("Population Density vs Vaccination Rate", fontsize=16, fontweight="bold")
plt.xlabel("Population Density")
plt.ylabel("Vaccination Rate")
plt.grid(True, linestyle="--", alpha=0.4)
plt.tight_layout()
plt.show()


x_reg = df[features]
y_reg = df["cases_last_week"]

print("\nTrain Test Split Explorer")

for test_size in [0.2, 0.3, 0.4]:
    x_train, x_test, y_train, y_test = train_test_split(
        x_reg,
        y_reg,
        test_size=test_size,
        random_state=42,
    )

    reg_model = LinearRegression()
    reg_model.fit(x_train, y_train)
    y_pred = reg_model.predict(x_test)

    print("\nTest Size:", test_size)
    print("Train Rows:", len(x_train))
    print("Test Rows:", len(x_test))
    print("MAE:", round(mean_absolute_error(y_test, y_pred), 2))
    print("R2 Score:", round(r2_score(y_test, y_pred), 2))


x_train, x_test, y_train, y_test = train_test_split(
    x_reg,
    y_reg,
    test_size=0.3,
    random_state=42,
)

reg_model = LinearRegression()
reg_model.fit(x_train, y_train)
y_pred = reg_model.predict(x_test)

print("\nYour First Regression")
print("Mean Absolute Error:", round(mean_absolute_error(y_test, y_pred), 2))
print("R2 Score:", round(r2_score(y_test, y_pred), 2))


plt.figure(figsize=(8, 5))
plt.barh(features, abs(reg_model.coef_), color="#14b8a6", edgecolor="black")
plt.title("Feature Comparison", fontsize=16, fontweight="bold")
plt.xlabel("Feature Importance")
plt.ylabel("Features")
plt.grid(axis="x", linestyle="--", alpha=0.4)
plt.tight_layout()
plt.show()


plt.figure(figsize=(7, 5))
plt.scatter(y_test, y_pred, color="#2563eb", edgecolor="black", s=90)

min_value = min(y_test.min(), y_pred.min())
max_value = max(y_test.max(), y_pred.max())

plt.plot([min_value, max_value], [min_value, max_value], color="red", linewidth=2)
plt.title("Predicted vs Actual Cases", fontsize=16, fontweight="bold")
plt.xlabel("Actual Cases")
plt.ylabel("Predicted Cases")
plt.grid(True, linestyle="--", alpha=0.4)
plt.tight_layout()
plt.show()


x_cls = df[features]
y_cls = df["risk_class"]

x_train, x_test, y_train, y_test = train_test_split(
    x_cls,
    y_cls,
    test_size=0.4,
    random_state=42,
    stratify=y_cls,
)

smote = SMOTE(random_state=42, k_neighbors=1)
x_train_smote, y_train_smote = smote.fit_resample(x_train, y_train)

rf_model = RandomForestClassifier(n_estimators=100, random_state=42)
rf_model.fit(x_train_smote, y_train_smote)

y_pred_cls = rf_model.predict(x_test)

print("\nRandom Forest Classification Report")
print(classification_report(y_test, y_pred_cls, labels=risk_order, zero_division=0))

joblib.dump(rf_model, "model.pkl")

print("Model saved as model.pkl")